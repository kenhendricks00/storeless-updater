// Installer wizard. Single window, screen switched by `current-screen`.
// Proxy mode reuses this window but stays on `current-screen == 10` (status).
//
// Screen IDs:
//   0 Welcome       3 Options
//   1 Mode          4 Progress
//   2 Path          5 Done        6 Error
//  10 Proxy status
//  11 Checking for updates (splash)
//  12 Update available (confirm + defer options)
//  13 Up to date (brief confirmation)
//  20 Uninstall confirm
//  21 Uninstall progress   (reuses progress-phase/progress-detail/progress-*)
//  22 Uninstall done
//  23 Uninstall error/refused
//  30 Launcher update prompt
//  31 Launcher self-update done (restart-to-apply notice)

import { VerticalBox, HorizontalBox, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";

// ChatGPT-inspired light palette shared by every wizard state.
global Palette {
    out property <color> canvas: #ffffff;
    out property <color> text: #0d0d0d;
    out property <color> text-secondary: #6b6b6b;
    out property <color> text-tertiary: #8a8a8a;
    out property <color> divider: #e5e5e5;
    out property <color> control: #0d0d0d;
    out property <color> control-hover: #2f2f2f;
    out property <color> control-pressed: #000000;
    out property <color> control-text: #ffffff;
    out property <color> surface: #f7f7f8;
    out property <color> surface-hover: #eeeeef;
    out property <color> success: #188038;
    out property <color> danger: #c92a2a;
}

component ChatButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> disabled: false;
    callback clicked;
    height: 44px;
    min-width: 104px;
    border-radius: 9px;
    background: ta.pressed && !root.disabled
        ? Palette.control-pressed
        : (ta.has-hover && !root.disabled ? Palette.control-hover : Palette.control);
    opacity: root.disabled ? 0.5 : 1.0;
    // HorizontalLayout drives the Rectangle's preferred width from the
    // Text's measured size + padding. Without a layout the Text is overlaid
    // and `min-width: 96px` is the only width source — wider labels clip.
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        Text {
            text: root.text;
            color: Palette.control-text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected: false;
    callback clicked;
    height: 68px;
    border-radius: 10px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.text : Palette.divider;
    background: ta.has-hover ? Palette.surface-hover : Palette.surface;
    VerticalBox {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        Text {
            text: root.title;
            color: Palette.text;
            font-size: 14px;
            font-weight: 600;
        }
        Text {
            text: root.subtitle;
            color: Palette.text-secondary;
            font-size: 12px;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    // Wizard state (bound both ways — UI writes, Rust reads at install time).
    in-out property <int> current-screen: 0;
    in-out property <int> install-mode: 0; // 0=portable 1=user 2=system
    in-out property <string> install-path;
    in-out property <bool> create-shortcut: true;
    in-out property <bool> register-uninstall: true;
    in-out property <bool> use-current-junction: true;
    in-out property <int> keep-versions: 2;
    in-out property <int> fetcher: 0; // 0=direct 1=winget

    // Progress / status (Rust writes, UI reads).
    in property <string> progress-phase: "";
    in property <string> progress-detail: "";
    in property <float> progress-fraction: 0.0;
    in property <bool> progress-indeterminate: false;
    in property <string> error-text: "";
    in property <string> installed-version: "";

    // Proxy-mode status (screen 10).
    in property <string> proxy-status: "";

    // Update flow (screens 11/12/13).
    in property <string> update-current-version: "";
    in property <string> update-latest-version: "";
    in property <string> update-error-text: "";

    // Uninstall flow (screens 20/21/22/23).
    in property <string> uninstall-log-path: "";

    // Launcher self-update prompt (screen 30).
    in property <string> launcher-current-version: "";
    in property <string> launcher-latest-version: "";
    // Empty means "no launcher update pending"; non-empty is the URL to open
    // when the user clicks "View release".
    in property <string> launcher-release-url: "";

    // Callbacks to Rust.
    callback request-install();
    callback request-cancel();
    callback request-launch();
    callback request-quit();
    callback mode-selected(int);
    callback path-browse();
    // Update-flow callbacks. defer-choice encodes: 0=UpdateNow, 1=NotNow,
    // 2=SkipThisVersion, 3=SnoozeOneDay, 4=SnoozeSevenDays, 5=Never.
    callback request-update(int);
    callback request-check-updates();
    callback request-uninstall-start();
    // Launcher prompt callbacks. action encodes: 0=ViewRelease (doesn't dismiss),
    // 1=NotNow, 2=SkipThisVersion, 3=SnoozeOneDay, 4=SnoozeSevenDays, 5=Never,
    // 6=ApplyUpdate (download + replace running launcher).
    callback request-launcher-action(int);

    title: "Storeless Updater";
    width: 700px;
    height: 500px;
    background: Palette.canvas;
    default-font-family: "Segoe UI";
    // Launcher reminder is shown after Codex is launched/focused, which
    // would otherwise bury it. Pin only on screen 30 so other screens
    // behave normally.
    always-on-top: current-screen == 30 || current-screen == 31;

    VerticalBox {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 26px;
        padding-bottom: 20px;
        spacing: 18px;

        // Header
        HorizontalBox {
            padding: 0px;
            Text {
                text: "Storeless Updater";
                font-size: 26px;
                font-weight: 700;
                color: Palette.text;
            }
            Rectangle {} // spacer
            Text {
                text: root.current-screen == 10 ? "" :
                      root.current-screen == 11 ? "Working…" :
                      root.current-screen == 12 ? "" :
                      root.current-screen == 13 ? "Up to date" :
                      root.current-screen == 20 ? "Uninstall ChatGPT" :
                      root.current-screen == 21 ? "Working…" :
                      root.current-screen == 22 ? "Uninstall complete" :
                      root.current-screen == 23 ? "Uninstall failed" :
                      root.current-screen == 30 ? "Launcher update available" :
                      root.current-screen == 31 ? "Launcher updated" :
                      root.current-screen == 0 ? "Welcome" :
                      root.current-screen == 1 ? "Step 1 / 3" :
                      root.current-screen == 2 ? "Step 2 / 3" :
                      root.current-screen == 3 ? "Step 3 / 3" :
                      root.current-screen == 4 ? "Working…" :
                      root.current-screen == 5 ? "Done" : "Error";
                color: Palette.text-secondary;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: Palette.divider; }

        // Body (screen-specific)
        Rectangle {
            vertical-stretch: 1;

            // Welcome
            if root.current-screen == 0 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Unofficial Storeless Updater for ChatGPT on Windows.";
                    color: Palette.text;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Downloads Microsoft's signed package directly, verifies it, and extracts it. The Microsoft Store app is not required.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 8px; }
                Text { text: "Click Next to choose where to install."; color: Palette.text-secondary; font-size: 12px; }
            }

            // Mode
            if root.current-screen == 1 : VerticalBox {
                spacing: 8px;
                Text {
                    text: "Where should ChatGPT be installed?";
                    color: Palette.text;
                    font-size: 14px;
                }
                ModeCard {
                    title: "Portable  (recommended)";
                    subtitle: "Self-contained folder. No registry, no shortcuts unless you add them.";
                    selected: root.install-mode == 0;
                    clicked => { root.install-mode = 0; root.mode-selected(0); }
                }
                ModeCard {
                    title: "User install";
                    subtitle: "%LOCALAPPDATA%\\Storeless Updater — no admin required.";
                    selected: root.install-mode == 1;
                    clicked => { root.install-mode = 1; root.mode-selected(1); }
                }
                ModeCard {
                    title: "System install";
                    subtitle: "C:\\Program Files\\Storeless Updater — requires admin, shared across users.";
                    selected: root.install-mode == 2;
                    clicked => { root.install-mode = 2; root.mode-selected(2); }
                }
            }

            // Path
            if root.current-screen == 2 : VerticalBox {
                spacing: 8px;
                Text { text: "Install location"; color: Palette.text; font-size: 14px; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    LineEdit {
                        text <=> root.install-path;
                        horizontal-stretch: 1;
                    }
                    ChatButton { text: "Browse…"; clicked => { root.path-browse(); } }
                }
                Text {
                    text: "A `versions/` subdirectory will hold each installed MSIX version. The launcher sits at the root and re-launches the newest version.";
                    color: Palette.text-tertiary;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Options
            if root.current-screen == 3 : VerticalBox {
                spacing: 12px;
                Text { text: "Options"; color: Palette.text; font-size: 14px; }

                CheckBox { text: "Create Start Menu shortcut"; checked <=> root.create-shortcut; }
                CheckBox {
                    text: "Register in Add/Remove Programs (enables one-click uninstall)";
                    checked <=> root.register-uninstall;
                }
                CheckBox {
                    text: "Maintain versions/current junction (recommended)";
                    checked <=> root.use-current-junction;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text { text: "Keep previous versions:"; color: Palette.text; vertical-alignment: center; }
                    ComboBox {
                        model: ["1", "2", "3", "5"];
                        current-index: root.keep-versions == 1 ? 0 : root.keep-versions == 2 ? 1 : root.keep-versions == 3 ? 2 : 3;
                        selected(v) => {
                            root.keep-versions = v == "1" ? 1 : v == "2" ? 2 : v == "3" ? 3 : 5;
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text { text: "Fetcher:"; color: Palette.text; vertical-alignment: center; }
                    ComboBox {
                        model: ["Direct  (recommended)", "Winget  (may require Entra ID)"];
                        current-index <=> root.fetcher;
                    }
                }

                Text {
                    text: "Direct downloads the MSIX from Microsoft's delivery CDN via the Store's own protocol. Winget shells out to winget.exe and currently requires a Microsoft Entra work/school account for Store packages.";
                    color: Palette.text-tertiary;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Progress
            if root.current-screen == 4 : VerticalBox {
                spacing: 22px;
                Rectangle { vertical-stretch: 1; } // top spacer
                Text {
                    text: root.progress-phase;
                    color: Palette.text;
                    font-size: 20px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: Palette.divider;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: root.progress-indeterminate
                            ? parent.width * 0.3
                            : parent.width * root.progress-fraction;
                        border-radius: 6px;
                        background: Palette.control;
                    }
                }
                Text {
                    text: root.progress-detail;
                    color: Palette.text;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; } // bottom spacer
            }

            // Done
            if root.current-screen == 5 : VerticalBox {
                spacing: 14px;
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 12px;
                    Rectangle {}
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        border-width: 2px;
                        border-color: Palette.success;
                        Text {
                            text: "✓";
                            font-family: "Segoe UI Symbol";
                            color: Palette.success;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "ChatGPT is installed.";
                        color: Palette.success;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                }
                Text {
                    text: "Version " + root.installed-version;
                    color: Palette.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Error
            if root.current-screen == 6 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Installation failed";
                    color: Palette.danger;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.error-text;
                    color: Palette.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // Proxy status
            if root.current-screen == 10 : VerticalBox {
                spacing: 10px;
                Text { text: "Proxy mode"; color: Palette.text-secondary; font-size: 14px; font-weight: 600; }
                Text { text: root.proxy-status; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
            }

            // Checking for updates
            if root.current-screen == 11 : VerticalBox {
                spacing: 22px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Checking for updates…";
                    color: Palette.text;
                    font-size: 20px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: Palette.divider;
                    Rectangle {
                        x: 0; y: 0;
                        height: parent.height;
                        width: parent.width * 0.3;
                        border-radius: 6px;
                        background: Palette.control;
                    }
                }
                Text {
                    text: "Contacting Microsoft's package catalog…";
                    color: Palette.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Update available
            if root.current-screen == 12 : VerticalBox {
                spacing: 18px;
                Text {
                    text: "A new version of ChatGPT is available.";
                    color: Palette.text;
                    font-size: 20px;
                    font-weight: 400;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 22px;
                    VerticalBox {
                        width: 150px;
                        spacing: 6px;
                        padding: 0px;
                        Text { text: "Installed"; color: Palette.text-tertiary; font-size: 13px; }
                        Text {
                            text: root.update-current-version;
                            color: Palette.text;
                            font-size: 17px;
                        }
                    }
                    Rectangle { width: 1px; background: Palette.divider; }
                    VerticalBox {
                        width: 170px;
                        spacing: 6px;
                        padding: 0px;
                        Text { text: "Latest"; color: Palette.text-tertiary; font-size: 13px; }
                        Text {
                            text: root.update-latest-version;
                            color: Palette.text;
                            font-size: 17px;
                            font-weight: 600;
                        }
                    }
                    Rectangle {}
                }
                Rectangle { height: 1px; background: Palette.divider; }
                Text { text: "Don't update now?"; color: Palette.text-secondary; font-size: 14px; font-weight: 600; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 12px;
                    ChatButton { text: "Remind next time"; horizontal-stretch: 1; clicked => { root.request-update(1); } }
                    ChatButton { text: "Snooze 1 day"; horizontal-stretch: 1; clicked => { root.request-update(3); } }
                    ChatButton { text: "Snooze 7 days"; horizontal-stretch: 1; clicked => { root.request-update(4); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 12px;
                    ChatButton { text: "Skip this version"; horizontal-stretch: 1; clicked => { root.request-update(2); } }
                    ChatButton { text: "Never check again"; horizontal-stretch: 1; clicked => { root.request-update(5); } }
                }
            }

            // Up to date
            if root.current-screen == 13 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "ChatGPT is up to date.";
                    color: Palette.success;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.update-current-version;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: confirm
            if root.current-screen == 20 : VerticalBox {
                spacing: 12px;
                Text {
                    text: "Uninstall ChatGPT?";
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "This will remove the launcher, Start Menu shortcut, and all installed versions of ChatGPT.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Your ChatGPT logs and sign-in data will NOT be deleted.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: progress (reuses the same progress-* properties as screen 4)
            if root.current-screen == 21 : VerticalBox {
                spacing: 14px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.progress-phase;
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: Palette.divider;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: root.progress-indeterminate
                            ? parent.width * 0.3
                            : parent.width * root.progress-fraction;
                        border-radius: 6px;
                        background: Palette.danger;
                    }
                }
                Text {
                    text: root.progress-detail;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: complete
            if root.current-screen == 22 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "ChatGPT has been uninstalled.";
                    color: Palette.success;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.uninstall-log-path == "" ? "" : "Log: " + root.uninstall-log-path;
                    color: Palette.text-tertiary;
                    font-size: 10px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: error / refused
            if root.current-screen == 23 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Uninstall failed";
                    color: Palette.danger;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.error-text;
                    color: Palette.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // Launcher self-update prompt (screen 30) — informational, doesn't gate Codex.
            if root.current-screen == 30 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "A new version of this launcher is available.";
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 16px;
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Installed"; color: Palette.text-tertiary; font-size: 11px; }
                        Text {
                            text: root.launcher-current-version;
                            color: Palette.text-secondary;
                            font-size: 14px;
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Latest"; color: Palette.text-tertiary; font-size: 11px; }
                        Text {
                            text: root.launcher-latest-version;
                            color: Palette.success;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }
                    Rectangle {}
                }
                Rectangle { height: 1px; background: Palette.divider; }
                // Primary action row: update + view release notes.
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    ChatButton {
                        text: "Update launcher";
                        primary: true;
                        clicked => { root.request-launcher-action(6); }
                    }
                    ChatButton {
                        text: "Release notes";
                        clicked => { root.request-launcher-action(0); }
                    }
                    Rectangle {} // spacer pushes primary actions to the left
                }
                Rectangle { height: 4px; }
                // Defer row(s): muted, secondary group.
                Text { text: "Or defer"; color: Palette.text-tertiary; font-size: 11px; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    ChatButton { text: "Remind next time";  clicked => { root.request-launcher-action(1); } }
                    ChatButton { text: "Snooze 1 day";       clicked => { root.request-launcher-action(3); } }
                    ChatButton { text: "Snooze 7 days";      clicked => { root.request-launcher-action(4); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    ChatButton { text: "Skip this version";  clicked => { root.request-launcher-action(2); } }
                    ChatButton { text: "Never";              clicked => { root.request-launcher-action(5); } }
                }
            }

            // Launcher self-update succeeded (screen 31).
            if root.current-screen == 31 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Launcher updated.";
                    color: Palette.success;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.launcher-latest-version;
                    color: Palette.text;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Close this window to finish. The new launcher will be used the next time you start ChatGPT.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Footer nav
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            // Back
            if root.current-screen >= 1 && root.current-screen <= 3 : ChatButton {
                text: "Back";
                clicked => { root.current-screen = root.current-screen - 1; }
            }
            Rectangle {} // spacer

            if root.current-screen == 0 : ChatButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen <= 3 && root.current-screen != 0 : ChatButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 0 : ChatButton {
                text: "Next";
                primary: true;
                clicked => { root.current-screen = 1; }
            }
            if root.current-screen == 1 : ChatButton {
                text: "Next";
                primary: true;
                clicked => { root.current-screen = 2; }
            }
            if root.current-screen == 2 : ChatButton {
                text: "Next";
                primary: true;
                disabled: root.install-path == "";
                clicked => { root.current-screen = 3; }
            }
            if root.current-screen == 3 : ChatButton {
                text: "Install";
                primary: true;
                clicked => { root.current-screen = 4; root.request-install(); }
            }
            if root.current-screen == 5 : ChatButton {
                text: "Launch ChatGPT";
                primary: true;
                clicked => { root.request-launch(); }
            }
            if root.current-screen == 5 : ChatButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 6 : ChatButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 10 : ChatButton {
                text: "Check for updates";
                clicked => { root.request-check-updates(); }
            }
            if root.current-screen == 10 : ChatButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 12 : ChatButton {
                text: "Update now";
                primary: true;
                clicked => { root.request-update(0); }
            }
            if root.current-screen == 13 : ChatButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            // Uninstall confirm
            if root.current-screen == 20 : ChatButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 20 : ChatButton {
                text: "Uninstall";
                primary: true;
                clicked => { root.current-screen = 21; root.request-uninstall-start(); }
            }
            // Uninstall complete / error
            if root.current-screen == 22 : ChatButton {
                text: "Close";
                primary: true;
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 23 : ChatButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            // Launcher self-update done
            if root.current-screen == 31 : ChatButton {
                text: "Close";
                primary: true;
                clicked => { root.request-quit(); }
            }
        }

    }
}
